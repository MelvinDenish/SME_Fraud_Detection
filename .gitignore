# --- ML artifacts ----------------------------------------------------------
# Small pretrained weights + calibration are checked in so the GHCR build
# ships them in the image. Anything large (training caches, checkpoints, raw
# datasets) stays ignored.
.torch_cache/
ml/artifacts/checkpoints/
ml/artifacts/*.npz
ml/artifacts/*.bin
data/raw/
data/interim/
data/processed/
data/uploads/
*.parquet
*.feather

