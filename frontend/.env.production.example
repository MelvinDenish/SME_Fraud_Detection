# Sentinel-G frontend — production env template (PRD §10 Day 28).
# Copy to `.env.production` and edit. Vercel reads either this file at
# build time OR the env vars set via `vercel env add VITE_API_BASE production`.
#
# Locally: `npm run build` picks up .env.production automatically.
# On Vercel: prefer `vercel env add VITE_API_BASE production` instead of
# committing a real .env.production.

# Absolute base URL of the FastAPI backend on Oracle Cloud.
# Leave the trailing slash off — the client strips it anyway.
VITE_API_BASE=https://sentinel-g.duckdns.org
